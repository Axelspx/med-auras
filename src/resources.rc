#include <windows.h>
#include "resource.h"

IDD_MEDICATION_EDITOR DIALOGEX 0, 0, 250, 172
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Medication"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name", -1, 10, 12, 62, 10
    EDITTEXT        IDC_MEDICATION_NAME, 76, 9, 144, 14, ES_AUTOHSCROLL
    LTEXT           "Dose", -1, 10, 38, 62, 10
    EDITTEXT        IDC_MEDICATION_DOSE, 76, 35, 144, 14, ES_AUTOHSCROLL
    LTEXT           "Interval", -1, 10, 64, 62, 10
    EDITTEXT        IDC_MEDICATION_INTERVAL, 76, 61, 70, 14, ES_AUTOHSCROLL
    COMBOBOX        IDC_MEDICATION_UNIT, 152, 61, 88, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Start", -1, 10, 91, 62, 10
    CONTROL         "", IDC_MEDICATION_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 76, 87, 94, 15
    CONTROL         "", IDC_MEDICATION_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | WS_TABSTOP, 176, 87, 64, 15
    LTEXT           "Start is the initial timer anchor.", -1, 76, 108, 164, 10
    DEFPUSHBUTTON   "Save", IDOK, 132, 144, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 144, 50, 16
END
