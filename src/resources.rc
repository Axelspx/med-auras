#include <windows.h>
#include "resource.h"

// version.h is generated by CMake from src/version.h.in. Bump the version in
// CMakeLists.txt; there is no number to edit here.
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MED_AURAS_VERSION_MAJOR, MED_AURAS_VERSION_MINOR, MED_AURAS_VERSION_PATCH, 0
PRODUCTVERSION  MED_AURAS_VERSION_MAJOR, MED_AURAS_VERSION_MINOR, MED_AURAS_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", "MedAuras medication timer widget"
            VALUE "FileVersion",     MED_AURAS_VERSION_STRING
            VALUE "InternalName",    "med-auras"
            VALUE "OriginalFilename","med-auras.exe"
            VALUE "ProductName",     "MedAuras"
            VALUE "ProductVersion",  MED_AURAS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END

IDD_MEDICATION_EDITOR DIALOGEX 0, 0, 260, 244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Medication"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name", -1, 10, 12, 62, 10
    EDITTEXT        IDC_MEDICATION_NAME, 76, 9, 174, 14, ES_AUTOHSCROLL
    LTEXT           "Dose", -1, 10, 38, 62, 10
    EDITTEXT        IDC_MEDICATION_DOSE, 76, 35, 174, 14, ES_AUTOHSCROLL
    LTEXT           "Icon", -1, 10, 64, 62, 10
    EDITTEXT        IDC_MEDICATION_ICON, 76, 61, 86, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Browse...", IDC_BROWSE_ICON, 168, 60, 44, 16
    PUSHBUTTON      "Clear", IDC_CLEAR_ICON, 216, 60, 34, 16
    LTEXT           "Schedule", -1, 10, 90, 62, 10
    COMBOBOX        IDC_SCHEDULE_TYPE, 76, 87, 90, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Every", IDC_HOURLY_EVERY_LABEL, 10, 116, 62, 10
    EDITTEXT        IDC_MEDICATION_INTERVAL, 76, 113, 50, 14, ES_AUTOHSCROLL
    COMBOBOX        IDC_MEDICATION_UNIT, 132, 113, 70, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Starting", IDC_HOURLY_START_LABEL, 10, 142, 62, 10
    CONTROL         "", IDC_MEDICATION_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 76, 139, 94, 15
    CONTROL         "", IDC_MEDICATION_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | WS_TABSTOP, 176, 139, 64, 15

    LTEXT           "Add a time", IDC_ENTRY_LABEL, 10, 116, 62, 10
    COMBOBOX        IDC_ENTRY_DAY, 76, 113, 84, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_ENTRY_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | WS_TABSTOP, 166, 113, 54, 15
    PUSHBUTTON      "Add", IDC_ADD_ENTRY, 224, 112, 26, 16
    PUSHBUTTON      "Remove", IDC_REMOVE_ENTRY, 10, 136, 62, 16
    LISTBOX         IDC_ENTRY_LIST, 76, 136, 174, 60, LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_SCHEDULE_HINT, 10, 202, 240, 10
    DEFPUSHBUTTON   "Save", IDOK, 142, 218, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 218, 50, 16
END

IDD_HISTORY DIALOGEX 0, 0, 268, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "History"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX         IDC_HISTORY_LIST, 10, 10, 248, 148, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDOK, 208, 166, 50, 16
END

IDD_BACKGROUND DIALOGEX 0, 0, 214, 128
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Background"
FONT 9, "Segoe UI"
BEGIN
    AUTORADIOBUTTON "Solid", IDC_BACKGROUND_SOLID, 12, 12, 60, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Blur", IDC_BACKGROUND_BLUR, 80, 12, 60, 12
    LTEXT           "Colour", -1, 12, 36, 40, 10
    CONTROL         "", IDC_BACKGROUND_COLOR, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 60, 32, 40, 18
    LTEXT           "Opacity", -1, 12, 62, 40, 10
    CONTROL         "", IDC_BACKGROUND_ALPHA, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 56, 58, 118, 20
    LTEXT           "255", IDC_BACKGROUND_ALPHA_VALUE, 178, 62, 26, 10
    LTEXT           "", IDC_BACKGROUND_HINT, 12, 86, 192, 10
    DEFPUSHBUTTON   "Save", IDOK, 96, 104, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 104, 50, 16
END
